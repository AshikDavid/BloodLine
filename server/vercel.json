{
    "installCommand": "npm install --legacy-peer-deps",
    "version": 2,
    "builds": [
        {
            "src": "server/package.json",
            "use": "@vercel/node"
        },
        {
            "src": "src/**/*",
            "use": "@vercel/static",
            
        }
    ],
    "routes":[
        {"src": "/(.*)", "dest": "/"}
    ]
}